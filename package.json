{
  "name": "finsight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/stamp-sw.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "test:stress": "for i in 1 2 3 4 5; do vitest run || exit 1; done",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=line"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.14.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.39",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
