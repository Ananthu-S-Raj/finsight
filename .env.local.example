NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SITE_URL=

# ===== AI features =====
# Master switch for the user-facing AI insights endpoint. Set to "false" to
# disable AI entirely (the app still works; AI responses fall back to the
# built-in on-device analysis).
AI_ENABLED=true

# Provider: "openai" or "ollama"
AI_PROVIDER=openai

# --- OpenAI (AI_PROVIDER=openai) ---
# Server-side only. Never commit this value. Leave blank to disable OpenAI.
OPENAI_API_KEY=
# Model id, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (Azure / self-hosted gateways)
OPENAI_BASE_URL=https://api.openai.com/v1
# Request timeout in milliseconds
OPENAI_TIMEOUT_MS=15000

# --- Ollama (AI_PROVIDER=ollama) ---
# Set OLLAMA_ENABLED=true when the local model server is reachable from this
# deployment. If Ollama is not reachable, AI falls back gracefully.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000

# ===== Rate limiting (in-app, server-side) =====
# Budgets for the endpoints FinSight owns. Login / registration / OTP are
# handled directly by Supabase Auth (hosted) and throttled there. Leave unset
# to use the defaults shown.
#RATE_LIMIT_FORGOT_MAX=5
#RATE_LIMIT_FORGOT_WINDOW_MS=3600000
#RATE_LIMIT_RESET_CONSUME_MAX=10
#RATE_LIMIT_RESET_CONSUME_WINDOW_MS=3600000
#RATE_LIMIT_AI_USER_MAX=12
#RATE_LIMIT_AI_USER_WINDOW_MS=3600000
#RATE_LIMIT_AI_IP_MAX=30
#RATE_LIMIT_AI_IP_WINDOW_MS=3600000
#RATE_LIMIT_ADMIN_AUTH_IP_MAX=30
#RATE_LIMIT_ADMIN_AUTH_USER_MAX=15
#RATE_LIMIT_ADMIN_AUTH_WINDOW_MS=900000
#RATE_LIMIT_ADMIN_RESET_MAX=10
#RATE_LIMIT_ADMIN_RESET_WINDOW_MS=3600000

# ===== Edge functions (daily-reminder, process-recurring) =====
# Shared secret for the scheduled Edge Functions. When set, both functions
# require the matching `x-cron-secret` header and reject anonymous callers.
# The pg_cron schedules in supabase/schema.sql and
# supabase/migrations/20260811000001_recurring.sql send this header.
#CRON_SECRET=change-me
